# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/

# Python coverage and packaging output
.coverage
.coverage.*
htmlcov/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Local environment and secrets
.env
.env.*
!.env.example

# C/C++ and local build output
/build/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.ilk

# Editor and operating-system files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Runtime bundle exporter outputs (README files remain tracked)
models/compiled/reference/*.bin
models/compiled/reference/manifest.json
models/compiled/reference/execution_plans/*.bin
models/runtime/**/*.camppmodel

# Large runtime validation tensor dumps and traces
runs/runtime/ort_reference/*
!runs/runtime/ort_reference/README.md
runs/runtime/c_reference/*
!runs/runtime/c_reference/README.md
runs/runtime/operator_replay/*
!runs/runtime/operator_replay/README.md
runs/runtime/pipelines/
runs/model_packages/
runs/models/

# Raw run artifacts under runs/ — regenerable by the pipeline scripts.
# Generation-agnostic: applies to e7_98, e7_298, e7_498, e7_998 and any future bucket.
runs/**/perf.data
runs/**/perf_script.txt
runs/**/perf_record.stderr.txt
runs/**/*.bin
runs/**/*.f32
runs/**/raw/
runs/**/raw_batch/
runs/**/retained/
runs/**/validation/
runs/**/validation_inputs/
runs/**/bundle/

# Curated results: keep summaries and CSVs, drop the multi-MB dumps
results/graph/ir_*.json
results/**/operator_profile.json
results/runtime/c_runtime_compare/compare_*.json
results/static/*.onnx

# Layer-hybrid V3 작업 산출물 (2026-08-20) — 전부 재생성 가능
# /build/ 규칙에 이미 걸리지만, 경로를 옮겨도 새어나가지 않도록 명시해 둔다.
**/.objcache_v3/
**/.verify_tmp/
campp_v3_verify/

# bucket별 operator profile은 18_remap_bucket_profile.py 로 재생성한다 (1.8MB/개).
# results/**/operator_profile.json 규칙이 이미 덮지만 의도를 남긴다.
results/profiling/e7_*/operator_profile.json

# Deployment bundle exporter outputs (README/JSON metadata remain tracked)
models/deploy/**/*.camppmodel
models/deploy/**/campp_runtime

# Regenerable backup archives
archive/*.tar.gz
