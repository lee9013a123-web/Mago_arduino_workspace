digraph campp {
  rankdir=TB;
  graph [fontname="Helvetica", labelloc="t", label="CAM++ static graph @ 1s (98 frames)"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="#eef3fb", color="#3b7dd8"];
  edge [fontname="Helvetica", fontsize=9, color="#666666"];
  input [shape=ellipse, fillcolor="#e8f5e9", color="#2e7d32"];
  output [shape=ellipse, fillcolor="#fdecea", color="#c62828"];
  "(root)" [label="(root)\n1 ops | 0 MAC\nw 0 B"];
  "head" [label="head\n7 ops | 0 MAC\nw 15 B"];
  "head/conv1" [label="head/conv1\n2 ops | 2.3 M MAC\nw 591 B"];
  "head/layer1" [label="head/layer1\n20 ops | 148.5 M MAC\nw 38 KB"];
  "head/layer2" [label="head/layer2\n20 ops | 74.3 M MAC\nw 38 KB"];
  "head/conv2" [label="head/conv2\n2 ops | 9.0 M MAC\nw 9 KB"];
  "xvector/tdnn" [label="xvector/tdnn\n3 ops | 10.0 M MAC\nw 201 KB"];
  "xvector/block1" [label="xvector/block1\n312 ops | 36.1 M MAC\nw 803 KB"];
  "xvector/transit1" [label="xvector/transit1\n5 ops | 6.4 M MAC\nw 137 KB"];
  "xvector/block2" [label="xvector/block2\n624 ops | 120.4 M MAC\nw 2.6 MB"];
  "xvector/transit2" [label="xvector/transit2\n5 ops | 25.7 M MAC\nw 531 KB"];
  "xvector/block3" [label="xvector/block3\n416 ops | 93.1 M MAC\nw 2.0 MB"];
  "xvector/transit3" [label="xvector/transit3\n5 ops | 25.7 M MAC\nw 533 KB"];
  "xvector/out_nonlinear" [label="xvector/out_nonlinear\n1 ops | 0 MAC\nw 0 B"];
  "xvector/stats" [label="xvector/stats\n9 ops | 0 MAC\nw 0 B"];
  "xvector/dense" [label="xvector/dense\n6 ops | 196.6 K MAC\nw 194 KB"];
  "(root)" -> "head" [label="31 KB"];
  "head" -> "head/conv1" [label="8 KB"];
  "head/conv1" -> "head" [label="980 KB"];
  "head" -> "head/layer1" [label="490 KB"];
  "head/layer1" -> "head/layer2" [label="245 KB"];
  "head/layer2" -> "head/conv2" [label="61 KB"];
  "head/conv2" -> "head" [label="122 KB"];
  "head" -> "xvector/tdnn" [label="31 KB"];
  "xvector/tdnn" -> "xvector/block1" [label="49 KB"];
  "xvector/block1" -> "xvector/transit1" [label="98 KB"];
  "xvector/transit1" -> "xvector/block2" [label="98 KB"];
  "xvector/block2" -> "xvector/transit2" [label="196 KB"];
  "xvector/transit2" -> "xvector/block3" [label="196 KB"];
  "xvector/block3" -> "xvector/transit3" [label="196 KB"];
  "xvector/transit3" -> "xvector/out_nonlinear" [label="98 KB"];
  "xvector/out_nonlinear" -> "xvector/stats" [label="294 KB"];
  "xvector/stats" -> "xvector/dense" [label="4 KB"];
  "input" -> "(root)" [label="31 KB"];
  "xvector/dense" -> "output" [label="768 B"];
}